<Window x:Class="TinyHex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:TinyHex.Behaviors"
        xmlns:vm="clr-namespace:TinyHex.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle, FallbackValue='TinyHex'}" Height="600" Width="1200">

    <!-- Keyboard shortcuts -->
    <Window.InputBindings>
        <!-- Ctrl + 'O' for Open -->
        <KeyBinding Command="{Binding OpenFileCommand}" Key="O" Modifiers="Control" />
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top" HorizontalAlignment="Stretch">
            <MenuItem Header="_File">
                <MenuItem Header="_Open" Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O">
                    <MenuItem.Icon>
                        <Image Source="/Resources/OpenFile.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top" Height="32">
            <Button Command="{Binding OpenFileCommand}" ToolTip="Open File (Ctrl+O)"
                    AutomationProperties.Name="Open File">
                <Image Source="/Resources/OpenFile.png" />
            </Button>
            <Separator />
            <TextBlock Text="Bytes per line:" VerticalAlignment="Center" Margin="4,0" />
            <ComboBox Width="80"
                      ItemsSource="{Binding BytesPerLineOptions}"
                      SelectedItem="{Binding BytesPerLine}"
                      AutomationProperties.Name="Bytes per Line" />
            <Separator />
            <TextBlock Text="Go to:" VerticalAlignment="Center" Margin="4,0" />
            <TextBox Width="100" VerticalContentAlignment="Center"
                     Text="{Binding GoToText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="File offset, decimal or hex with 0x prefix (commit with Enter)"
                     AutomationProperties.Name="Go to Offset">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding GoToCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </ToolBar>

        <ListView ItemsSource="{Binding Records}"
                  SelectedIndex="{Binding SelectedIndex}"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  ScrollViewer.IsDeferredScrollingEnabled="False"
                  ScrollViewer.CanContentScroll="True"
                  FontFamily="Consolas"
                  FontSize="14">
            <b:Interaction.Behaviors>
                <behaviors:DropBehavior Command="{Binding DropCommand}" />
                <behaviors:ScrollIntoViewBehavior Notifier="{Binding ScrollRequest}" />
            </b:Interaction.Behaviors>
        </ListView>
    </DockPanel>
</Window>
